diff --git a/internal/handler/setupredact.go b/internal/handler/setupredact.go
index 8dca7e75..0480ab64 100644
--- a/internal/handler/setupredact.go
+++ b/internal/handler/setupredact.go
@@ -15,14 +15,22 @@ import (
 // and their order are the same as redact() in static/setup/assist.js, and
 // testdata/setup-redact-cases.json holds the cases both are tested against.
 //
-// What goes: private key and certificate blocks, passwords in URLs, bearer
-// and basic credentials, a password given to curl -u / --user, the value of any assignment whose name ends in KEY,
-// SECRET, TOKEN, PASSWORD, DSN, SALT, HASH or CREDENTIAL(S) (env lines, YAML,
-// JSON), the same NAME=value pairs inside a line (password=, token=,
-// DB_PASSWORD=), JWTs, Simple Host keys and tokens
-// (shk_, shat_, shrt_, shac_, shc_, shcs_, shint_), common provider keys,
-// email addresses, and long hex or mixed-case base64 strings. Hostnames, IP
-// addresses and paths stay: they are what a diagnosis needs.
+// What goes: private key and certificate blocks, passwords in URLs (a "/" or
+// "@" in the password included), Authorization, Cookie, Set-Cookie and
+// X-...-Key/Token/Secret header values, bearer and basic credentials, a
+// password given to curl -u / --user (also glued: -uuser:pass, -fsSu),
+// --password and mysql -p, the value of any assignment whose name ends in
+// KEY, SECRET, TOKEN, PASS, PASSWORD, PASSPHRASE, DSN, SALT, HASH, COOKIE,
+// SIG or CREDENTIAL(S) (optionally followed by _ID, _BASE or _B64): at a line
+// start, after a docker compose "service | " prefix, as a quoted JSON key
+// anywhere, or as NAME=value anywhere, quoted values included. Then JWTs,
+// Simple Host keys and tokens (shk_, shat_, shrt_, shac_, shc_, shcs_,
+// shint_), common provider keys (UpCloud's ucat_ too), email addresses
+// (non-ASCII ones included), and long hex or mixed-case base64 strings.
+// Terminal colour codes and zero-width characters are removed first, so they
+// cannot split a name from its value. Hostnames, IP addresses and paths stay:
+// they are what a diagnosis needs. The rules catch the shapes they know; the
+// page says so, and shows the person what will be sent before it is.
 
 type setupRedactRule struct {
 	re   *regexp.Regexp
@@ -30,17 +38,28 @@ type setupRedactRule struct {
 	keep func(match string) bool // when set, a match it keeps is left alone
 }
 
+const (
+	setupRedactName     = `[A-Za-z0-9_.-]*(?:key|secret|token|pass|passwd|password|passphrase|pwd|dsn|salt|credentials?|cookie|sig|signature)(?:[_.-]?(?:base|b64|base64|id))?`
+	setupRedactLineName = `[A-Za-z0-9_.-]*(?:key|secret|token|pass|passwd|password|passphrase|pwd|dsn|salt|hash|credentials?|cookie|sig|signature)(?:[_.-]?(?:base|b64|base64|id))?`
+	setupRedactEmailCh  = `\x{a1}-\x{1fff}\x{2070}-\x{2fff}\x{3001}-\x{d7ff}\x{f900}-\x{ffef}`
+)
+
 var setupRedactRules = []setupRedactRule{
 	{re: regexp.MustCompile(`(?s)-----BEGIN ([A-Z0-9 ]+)-----.*?(?:-----END [A-Z0-9 ]+-----|$)`), with: "[redacted ${1}]"},
-	{re: regexp.MustCompile(`([A-Za-z][A-Za-z0-9+.-]*://)([^\t\n\f\r :/@]+):([^\t\n\f\r /@]+)@`), with: "${1}${2}:[redacted]@"},
+	{re: regexp.MustCompile(`([A-Za-z][A-Za-z0-9+.-]*://)([^\t\n\f\r :/@]+):([^\t\n\f\r '"<>?#]+)@`), with: "${1}${2}:[redacted]@"},
+	{re: regexp.MustCompile(`(?i)\b((?:proxy-)?authorization["']?[ \t]*[:=][ \t]*["']?)(?:([A-Za-z]+)([ \t]+))?[^\t\n\f\r '",]+`), with: "${1}${2}${3}[redacted]"},
+	{re: regexp.MustCompile(`(?i)\b(set-cookie|cookie|x-[A-Za-z0-9-]*(?:key|token|secret|signature|auth|session)[A-Za-z0-9-]*)(["']?[ \t]*:[ \t]*["']?)[^\t\n\f\r '"][^\n'"]*`), with: "${1}${2}[redacted]"},
 	{re: regexp.MustCompile(`(?i)\b(bearer|basic)([ \t]+)[A-Za-z0-9._~+/=-]{8,}`), with: "${1}${2}[redacted]"},
-	{re: regexp.MustCompile(`(?m)(^|[ \t])(-u|--user)([ \t]+|=)(?:(['"])([^\n:'"]+):[^\n'"]*|([^\t\n\f\r :'"]+):[^\t\n\f\r '"]+)`), with: "${1}${2}${3}${4}${5}${6}:[redacted]"},
-	{re: regexp.MustCompile(`(?im)^([ \t]*(?:export[ \t]+)?["']?[A-Za-z0-9_.-]*(?:key|secret|token|password|passwd|pwd|dsn|salt|hash|credentials?|key_id)["']?[ \t]*[:=][ \t]*)[^\t\n\f\r ].*$`), with: "${1}[redacted]"},
-	{re: regexp.MustCompile(`(?i)\b([A-Za-z0-9_.-]*(?:key|secret|token|password|passwd|pwd|dsn|salt|credentials?))=[^\t\n\f\r &;'",]+`), with: "${1}=[redacted]"},
-	{re: regexp.MustCompile(`\beyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}`), with: "[redacted token]"},
-	{re: regexp.MustCompile(`\b(?:sh(?:k|at|rt|ac|c|cs|int)_|sk-|sk_|pk_|rk_|re_|ghp_|gho_|ghu_|ghs_|ghr_|github_pat_|glpat-|xai-|xox[abpors]-)[A-Za-z0-9_-]{12,}`), with: "[redacted key]"},
+	{re: regexp.MustCompile(`(?m)(^|[ \t])(-[A-Za-z]*u|--user)([ \t]*|=)(?:(['"])([^\n:'"]+):[^\n'"]*|([^\t\n\f\r :'"]+):[^\t\n\f\r '"]+)`), with: "${1}${2}${3}${4}${5}${6}:[redacted]"},
+	{re: regexp.MustCompile(`(^|[ \t])(--pass(?:word|wd)?)([ \t]+|=)(["']?)[^\t\n\f\r '"]+`), with: "${1}${2}${3}${4}[redacted]"},
+	{re: regexp.MustCompile(`\b(mysql(?:dump|admin)?|mariadb(?:-dump|-admin)?)\b([^\n]*?[ \t])-p[^\t\n\f\r '"]+`), with: "${1}${2}-p[redacted]"},
+	{re: regexp.MustCompile(`(?im)^([ \t]*(?:[A-Za-z0-9_.-]+[ \t]+\|[ \t]*)?(?:export[ \t]+)?["']?` + setupRedactLineName + `["']?[ \t]*[:=][ \t]*)[^\t\n\f\r ].*$`), with: "${1}[redacted]"},
+	{re: regexp.MustCompile(`(?i)(["']` + setupRedactName + `["'][ \t]*:[ \t]*)(?:"(?:[^"\\\n]|\\.)*"|'[^'\n]*'|[^\t\n\f\r ,;}]+)`), with: "${1}[redacted]"},
+	{re: regexp.MustCompile(`(?i)\b(` + setupRedactName + `)=(?:"[^"\n]*"|'[^'\n]*'|[^\t\n\f\r &;'",]+)`), with: "${1}=[redacted]"},
+	{re: regexp.MustCompile(`\beyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{2,}`), with: "[redacted token]"},
+	{re: regexp.MustCompile(`\b(?:sh(?:k|at|rt|ac|c|cs|int)_|sk-|sk_|pk_|rk_|re_|ghp_|gho_|ghu_|ghs_|ghr_|github_pat_|glpat-|xai-|xox[abpors]-|ucat_)[A-Za-z0-9_-]{12,}`), with: "[redacted key]"},
 	{re: regexp.MustCompile(`\b(?:AKIA|ASIA)[0-9A-Z]{16}\b`), with: "[redacted key]"},
-	{re: regexp.MustCompile(`[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)+`), with: "[email]"},
+	{re: regexp.MustCompile(`[A-Za-z0-9._%+` + setupRedactEmailCh + `-]+[@\x{ff20}][A-Za-z0-9` + setupRedactEmailCh + `-]+(?:\.[A-Za-z0-9` + setupRedactEmailCh + `-]+)+`), with: "[email]"},
 	{re: regexp.MustCompile(`\b[0-9a-fA-F]{32,}\b`), with: "[redacted]"},
 	// Long base64-like strings with digits, lower and upper case: secrets,
 	// not paths or names.
@@ -49,13 +68,21 @@ var setupRedactRules = []setupRedactRule{
 	}},
 }
 
-// setupRedact returns s with line endings made \n, control characters other
-// than tab and newline removed, and every secret-looking part replaced.
+// Terminal escape sequences: CSI (colours, cursor) and OSC (titles, links).
+var setupRedactANSI = regexp.MustCompile(`\x1b\[[0-9;?]*[ -/]*[@-~]|\x1b\][^\x07\x1b\n]*(?:\x07|\x1b\\)?`)
+
+// setupRedact returns s with line endings made \n, terminal escape
+// sequences, zero-width characters and control characters other than tab
+// and newline removed, and every secret-looking part replaced.
 // Character classes are spelled out (not \s, \S) so the page's JavaScript,
 // whose \s also takes Unicode spaces, matches exactly the same text.
 func setupRedact(s string) string {
 	s = strings.NewReplacer("\r\n", "\n", "\r", "\n", "\u2028", "\n", "\u2029", "\n").Replace(s)
+	s = setupRedactANSI.ReplaceAllString(s, "")
 	s = strings.Map(func(r rune) rune {
+		if r >= 0x200b && r <= 0x200d || r == 0x2060 || r == 0xfeff {
+			return -1
+		}
 		if r == '\n' || r == '\t' || (r >= 0x20 && r != 0x7f && !(r >= 0x80 && r < 0xa0)) {
 			return r
 		}
diff --git a/internal/handler/static/privacy.html b/internal/handler/static/privacy.html
index 6a3b96f0..0e2a91fd 100644
--- a/internal/handler/static/privacy.html
+++ b/internal/handler/static/privacy.html
@@ -110,7 +110,7 @@ <h2 id="builder">Building with the AI in Simple Host</h2>
       <li><strong>Create with AI.</strong> If you use the builder on simple-host.app, your prompt and any files you attach are sent to xAI's Grok to write the site. xAI handles them under its own terms and privacy policy. We do not save your prompt in our database.</li>
       <li><strong>Ask assistants.</strong> Some of our own pages (the features, architecture and enterprise pages) have an "Ask" button that opens a small panel, such as "Ask about Simple Host". The question you type there is sent to xAI's Grok, together with a summary of those pages, to write the answer. A follow-up question also sends your last few questions and answers, so the answer has their context. Your browser keeps those last few questions and answers in this tab only, so the conversation stays with you as you move between the same assistant's pages; they are never sent to us to keep, and are gone when you close the tab. xAI handles it under its own terms and privacy policy. Nothing about you goes with it: not your IP address, browser, cookies or account. We do not store or log the question, and it is not linked to you. Our web server's standard log still records the request itself (time, address, IP, User-Agent), as for any page, and deletes it after 30 days.</li>
       <li><strong>Setup check.</strong> The setup helper (simple-host.app/setup) can check your choices just before it shows your files; you can skip it. It sends xAI's Grok only the product and the names and values of the numbers, durations, switches, choices and limits you changed, never hostnames, email addresses, secrets or anything about you, and we do not store or log them. To keep one network from using up everyone's checks, the server counts checks per network (your IP address shortened to its network, such as 198.51.100.0) in memory for that day only; the count is never written down. Our web server's standard log still records the request itself (time, address, IP, User-Agent), as for any page, and deletes it after 30 days.</li>
-      <li><strong>Setup assistant.</strong> The setup helper also has an assistant you can ask about settings, ask to fill in the form, or ask for help with an error. Each message sends xAI's Grok the product, where you are in the form, the same kind of choices as the check (numbers, durations, switches, choices and limits) and the answers you picked from lists (such as your sign-in provider or bucket provider), your message and the conversation's last few turns, which live only in the open page. Error output goes only when you paste it and click Send for help: keys, tokens, passwords and email addresses are removed first, in your browser and again on our server, and you see exactly what will be sent. Hostnames and addresses in the output stay, because they help find the cause. Never the hostnames, emails or secrets you type into the form, and nothing about you. We do not store or log any of it. The server counts messages per network in memory for that day only, as for the check. Our web server's standard log still records the request itself (time, address, IP, User-Agent), as for any page, and deletes it after 30 days.</li>
+      <li><strong>Setup assistant.</strong> The setup helper also has an assistant you can ask about settings, ask to fill in the form, or ask for help with an error. Each message sends xAI's Grok the product, where you are in the form, the same kind of choices as the check (numbers, durations, switches, choices and limits) and the answers you picked from lists (such as your sign-in provider or bucket provider), your message and the conversation's last few turns, which live only in the open page. Error output goes only when you paste it and click Send for help: the keys, tokens, passwords and email addresses we recognise are removed, in your browser and again on our server, and you see exactly what will be sent, so you can check it before sending. Hostnames and addresses in the output stay, because they help find the cause. Never the hostnames, emails or secrets you type into the form, and nothing about you. We do not store or log any of it. The server counts messages per network in memory for that day only, as for the check. Our web server's standard log still records the request itself (time, address, IP, User-Agent), as for any page, and deletes it after 30 days.</li>
       <li><strong>UpCloud sign-up link.</strong> The setup helper recommends UpCloud for running your own server. Its "Create your UpCloud account" button is a referral link: if you follow it, UpCloud learns you came from us, as with any referral, and gives new accounts the credit it describes. The page never asks for, sends or stores UpCloud credentials; the prompt it gives your AI agent tells the agent to use the ones you set in your own terminal and never to show or save them.</li>
       <li><strong>Voice input.</strong> If you speak a prompt, the recording is turned into text on our own server and deleted straight after. It is not sent to anyone else.</li>
     </ul>
