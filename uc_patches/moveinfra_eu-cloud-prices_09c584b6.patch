+# Security policy
+
+This repository publishes data and a generator that runs in CI; it has no running service. If you find a
+security problem (for example in the workflow), report it privately via **Security → Report a vulnerability** or
+email **hello@moveinfra.eu** with "security" in the subject. We reply within 3 working days.
diff --git a/cmd/pricegen/aws.go b/cmd/pricegen/aws.go
new file mode 100644
index 0000000..35abd65
--- /dev/null
+++ b/cmd/pricegen/aws.go
@@ -0,0 +1,160 @@
+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"strconv"
+	"strings"
+)
+
+const awsBase = "https://pricing.us-east-1.amazonaws.com/offers/v1.0/aws"
+
+type awsProduct struct {
+	ProductFamily string            `json:"productFamily"`
+	Attributes    map[string]string `json:"attributes"`
+}
+
+type awsTerm struct {
+	PriceDimensions map[string]struct {
+		PricePerUnit map[string]string `json:"pricePerUnit"`
+	} `json:"priceDimensions"`
+}
+
+// fetchAWS streams the EC2 bulk price file for Frankfurt (~400 MB) and keeps Linux on-demand instances.
+func fetchAWS() (*Source, error) {
+	url := fmt.Sprintf("%s/AmazonEC2/current/eu-central-1/index.json", awsBase)
+	src := &Source{Currency: "USD", Source: url}
+	specs := map[string]Server{} // sku -> server without price
+
+	body, err := get(url, nil)
+	if err != nil {
+		return nil, err
+	}
+	defer body.Close()
+	dec := json.NewDecoder(body)
+	if _, err := dec.Token(); err != nil {
+		return nil, err
+	}
+	for dec.More() {
+		tok, err := dec.Token()
+		if err != nil {
+			return nil, err
+		}
+		switch tok {
+		case "products":
+			err = eachEntry(dec, func(sku string) error {
+				var p awsProduct
+				if err := dec.Decode(&p); err != nil {
+					return err
+				}
+				a := p.Attributes
+				if p.ProductFamily != "Compute Instance" || a["locationType"] != "AWS Region" || a["operatingSystem"] != "Linux" ||
+					a["tenancy"] != "Shared" || a["preInstalledSw"] != "NA" || a["capacitystatus"] != "Used" || a["operation"] != "RunInstances" {
+					return nil
+				}
+				vcpu, _ := strconv.ParseFloat(a["vcpu"], 64)
+				mem, _ := strconv.ParseFloat(strings.TrimSuffix(strings.ReplaceAll(a["memory"], ",", ""), " GiB"), 64)
+				specs[sku] = Server{Name: a["instanceType"], VCPU: vcpu, MemoryGiB: mem, Category: awsCategory(a), Arch: awsArch(a)}
+				return nil
+			})
+		case "terms":
+			err = eachEntry(dec, func(kind string) error {
+				if kind != "OnDemand" {
+					return skip(dec)
+				}
+				return eachEntry(dec, func(sku string) error {
+					s, ok := specs[sku]
+					if !ok {
+						return skip(dec)
+					}
+					var terms map[string]awsTerm
+					if err := dec.Decode(&terms); err != nil {
+						return err
+					}
+					for _, t := range terms {
+						for _, d := range t.PriceDimensions {
+							if price, err := strconv.ParseFloat(d.PricePerUnit["USD"], 64); err == nil && price > 0 {
+								s.Monthly = price * hoursPerMonth
+								src.Servers = append(src.Servers, s)
+							}
+						}
+					}
+					return nil
+				})
+			})
+		default:
+			err = skip(dec)
+		}
+		if err != nil {
+			return nil, err
+		}
+	}
+	return src, nil
+}
+
+func awsCategory(a map[string]string) string {
+	t := a["instanceType"]
+	switch {
+	case strings.HasPrefix(t, "t"):
+		return "burstable"
+	case a["instanceFamily"] == "General purpose":
+		return "general"
+	case a["instanceFamily"] == "Compute optimized":
+		return "compute"
+	case a["instanceFamily"] == "Memory optimized":
+		return "memory"
+	case a["instanceFamily"] == "Storage optimized":
+		return "storage"
+	}
+	return "other" // GPU, FPGA, machine learning chips
+}
+
+func awsArch(a map[string]string) string {
+	if strings.Contains(lower(a["physicalProcessor"]), "graviton") {
+		return "arm"
+	}
+	return "x86"
+}
+
+// eachEntry walks a JSON object, calling fn with each key while the decoder sits on its value.
+func eachEntry(dec *json.Decoder, fn func(key string) error) error {
+	if _, err := dec.Token(); err != nil {
+		return err
+	}
+	for dec.More() {
+		tok, err := dec.Token()
+		if err != nil {
+			return err
+		}
+		key, ok := tok.(string)
+		if !ok {
+			return fmt.Errorf("unexpected token %v", tok)
+		}
+		if err := fn(key); err != nil {
+			return err
+		}
+	}
+	_, err := dec.Token()
+	return err
+}
+
+// skip consumes the next value token by token, so huge sections (Reserved terms) are never held in memory.
+func skip(dec *json.Decoder) error {
+	depth := 0
+	for {
+		tok, err := dec.Token()
+		if err != nil {
+			return err
+		}
+		if d, ok := tok.(json.Delim); ok {
+			if d == '{' || d == '[' {
+				depth++
+			} else {
+				depth--
+			}
+		}
+		if depth == 0 {
+			return nil
+		}
+	}
+}
diff --git a/cmd/pricegen/azure.go b/cmd/pricegen/azure.go
new file mode 100644
index 0000000..2924a22
--- /dev/null
+++ b/cmd/pricegen/azure.go
@@ -0,0 +1,141 @@
+package main
+
+import (
+	"net/url"
+	"regexp"
+	"strconv"
+	"strings"
+)
+
+const azureAPI = "https://prices.azure.com/api/retail/prices"
+
+type azureItem struct {
+	ArmSkuName    string  `json:"armSkuName"`
+	SkuName       string  `json:"skuName"`
+	ProductName   string  `json:"productName"`
+	UnitPrice     float64 `json:"unitPrice"`
+	UnitOfMeasure string  `json:"unitOfMeasure"`
+}
+
+// fetchAzure reads Linux pay-as-you-go VM prices in EUR from the Azure Retail Prices API.
+// The API has no vCPU or memory figures, so they are derived from the size name (see azureSpecs).
+func fetchAzure() (*Source, error) {
+	filter := "serviceName eq 'Virtual Machines' and armRegionName eq 'germanywestcentral' and priceType eq 'Consumption'"
+	next := azureAPI + "?" + url.Values{"currencyCode": {"EUR"}, "$filter": {filter}}.Encode()
+	src := &Source{Currency: "EUR", Source: azureAPI,
+		Note: "Memory is derived from the VM size name and Azure's published ratio per series; check sizes marked estimated."}
+	best := map[string]float64{}
+	for next != "" {
+		var page struct {
+			Items        []azureItem `json:"Items"`
+			NextPageLink string      `json:"NextPageLink"`
+		}
+		if err := getJSON(next, nil, &page); err != nil {
+			return nil, err
+		}
+		for _, it := range page.Items {
+			name := lower(it.SkuName + " " + it.ProductName)
+			if it.UnitOfMeasure != "1 Hour" || it.UnitPrice <= 0 || strings.Contains(name, "spot") ||
+				strings.Contains(name, "low priority") || strings.Contains(name, "windows") {
+				continue
+			}
+			if old, ok := best[it.ArmSkuName]; !ok || it.UnitPrice < old {
+				best[it.ArmSkuName] = it.UnitPrice
+			}
+		}
+		next = page.NextPageLink
+	}
+	for name, hourly := range best {
+		s, ok := azureSpecs(name)
+		if !ok {
+			continue
+		}
+		s.Monthly = hourly * hoursPerMonth
+		src.Servers = append(src.Servers, s)
+	}
+	return src, nil
+}
+
+// Standard_D4s_v5, Standard_E8-4ds_v5 (constrained vCPU), Standard_B2ms, Standard_A2m_v2, Standard_NC24ads_A100_v4
+var azureSize = regexp.MustCompile(`^Standard_([A-Z]+)(\d+)(?:-(\d+))?([a-z]*)(?:_[A-Z0-9]+)?(?:_v(\d+))?$`)
+
+// azureSpecs derives vCPU and memory from a VM size name. Sizes it cannot read are skipped.
+func azureSpecs(name string) (Server, bool) {
+	m := azureSize.FindStringSubmatch(name)
+	if m == nil {
+		return Server{}, false
+	}
+	series, suffix := m[1], m[4]
+	vcpu, _ := strconv.ParseFloat(m[2], 64)
+	if m[3] != "" { // constrained-core sizes keep the memory of the full size but expose fewer vCPUs
+		vcpu, _ = strconv.ParseFloat(m[3], 64)
+	}
+	full, _ := strconv.ParseFloat(m[2], 64)
+	gen, _ := strconv.Atoi(m[5])
+	s := Server{Name: name, VCPU: vcpu, Arch: "x86", Estimated: true}
+	if strings.Contains(suffix, "p") {
+		s.Arch = "arm"
+	}
+	if series == "D" && gen <= 2 && full >= 11 && full <= 15 { // D11-D15 (v1, v2) are memory-optimised with their own sizes
+		sizes := map[float64][2]float64{11: {2, 14}, 12: {4, 28}, 13: {8, 56}, 14: {16, 112}, 15: {20, 140}}
+		s.VCPU, s.MemoryGiB, s.Category = sizes[full][0], sizes[full][1], "memory"
+		return s, true
+	}
+	perCPU := 0.0
+	switch series {
+	case "D", "DC":
+		s.Category, perCPU = "general", 4
+		if series == "D" && gen <= 2 {
+			perCPU = 3.5 // Dv2 and the original D series
+		}
+		if strings.Contains(suffix, "l") {
+			perCPU = 2
+		}
+	case "E", "EC":
+		s.Category, perCPU = "memory", 8
+	case "F":
+		s.Category, perCPU = "compute", 2
+	case "A":
+		if gen < 2 {
+			s.Category = "other" // A v1: irregular sizes, retired
+			break
+		}
+		s.Category, perCPU = "general", 2
+		if strings.Contains(suffix, "m") {
+			perCPU = 8
+		}
+	case "L":
+		s.Category, perCPU = "storage", 8
+	case "B":
+		s.Category = "burstable"
+		s.MemoryGiB = azureBurstable(full, suffix, gen)
+	default: // M, H, N (GPU) and other special series: vCPU only
+		s.Category = "other"
+	}
+	if perCPU > 0 {
+		s.MemoryGiB = full * perCPU
+	}
+	return s, true
+}
+
+// azureBurstable covers the irregular B-series memory sizes.
+func azureBurstable(cpu float64, suffix string, gen int) float64 {
+	if gen >= 2 {
+		switch {
+		case strings.Contains(suffix, "t"):
+			return cpu / 2
+		case strings.Contains(suffix, "l"):
+			return cpu * 2
+		}
+		return cpu * 4
+	}
+	switch {
+	case strings.Contains(suffix, "ls"):
+		return 0.5
+	case strings.Contains(suffix, "ms"):
+		return cpu * 4
+	case cpu == 1:
+		return 1
+	}
+	return cpu * 2
+}
diff --git a/cmd/pricegen/build.go b/cmd/pricegen/build.go
new file mode 100644
index 0000000..07c3caa
--- /dev/null
+++ b/cmd/pricegen/build.go
@@ -0,0 +1,474 @@
+package main
+
+import (
+	"bytes"
+	"encoding/csv"
+	"fmt"
+	"math"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// Provider describes one column of the index.
+type Provider struct {
+	ID       string `json:"id"`
+	Name     string `json:"name"`
+	EUOwned  bool   `json:"euOwned"`
+	Region   string `json:"region"`
+	Location string `json:"location"`
+	Currency string `json:"sourceCurrency"`
+	Source   string `json:"serverSource"`
+	Fetched  string `json:"serversFetched"`
+	Note     string `json:"note,omitempty"`
+}
+
+var providerInfo = []Provider{
+	{ID: "aws", Name: "AWS", Location: "Frankfurt"},
+	{ID: "azure", Name: "Azure", Location: "Frankfurt (Germany West Central)"},
+	{ID: "gcp", Name: "Google Cloud", Location: "Frankfurt"},
+	{ID: "upcloud", Name: "UpCloud", EUOwned: true, Location: "Frankfurt"},
+	{ID: "hetzner", Name: "Hetzner", EUOwned: true, Location: "Falkenstein"},
+	{ID: "scaleway", Name: "Scaleway", EUOwned: true, Location: "Paris"},
+	{ID: "ovhcloud", Name: "OVHcloud", EUOwned: true, Location: "Europe"},
+}
+
+// Unit is a single unit price in EUR with where it came from.
+type Unit struct {
+	Price   float64 `json:"price"`
+	Product string  `json:"product,omitempty"`
+	Source  string  `json:"source"`
+	Note    string  `json:"note,omitempty"`
+}
+
+// Egress is internet data transfer out, in EUR. Tiers apply to the traffic above the free allowance.
+type Egress struct {
+	FreeGB    float64 `json:"freeGB"`
+	PerServer bool    `json:"perServer"` // the free allowance comes with every server
+	Tiers     []Tier  `json:"tiers"`
+	Source    string  `json:"source"`
+	Note      string  `json:"note,omitempty"`
+}
+
+type Tier struct {
+	FromGB float64  `json:"fromGB"`
+	ToGB   *float64 `json:"toGB"` // nil = no upper bound
+	PerGB  float64  `json:"perGB"`
+}
+
+// Services holds the unit prices of one provider. Nil means not offered or not verified.
+type Services struct {
+	BlockStorageGBMonth  *Unit   `json:"blockStorageGBMonth"`
+	ObjectStorageGBMonth *Unit   `json:"objectStorageGBMonth"`
+	LoadBalancerMonthly  *Unit   `json:"loadBalancerMonthly"`
+	KubernetesMonthly    *Unit   `json:"kubernetesMonthly"`
+	PostgresMonthly      *Unit   `json:"postgres2vCPU8GBMonthly"`
+	Egress               *Egress `json:"egress"`
+}
+
+// Price is one cell of a basket.
+type Price struct {
+	Monthly float64 `json:"monthly"`
+	Detail  string  `json:"detail"`
+}
+
+type Basket struct {
+	ID     string            `json:"id"`
+	Label  string            `json:"label"`
+	Prices map[string]*Price `json:"prices"` // nil = not offered or not verified
+}
+
+type Index struct {
+	Generated string `json:"generated"`
+	Currency  string `json:"currency"`
+	License   string `json:"license"`
+	FX        struct {
+		Date      string  `json:"date"`
+		USDPerEUR float64 `json:"usdPerEur"`
+		Source    string  `json:"source"`
+	} `json:"fx"`
+	Method    []string             `json:"method"`
+	Providers []Provider           `json:"providers"`
+	Baskets   []Basket             `json:"baskets"`
+	Services  map[string]*Services `json:"services"`
+	Servers   map[string][]Server  `json:"servers"`
+}
+
+var method = []string{
+	"Prices are list prices in EUR per month, excluding VAT, without discounts, commitments or free tiers unless stated.",
+	"A month is 730 hours, or the provider's monthly cap when it bills less (UpCloud 672 hours).",
+	"USD prices are converted at the ECB reference rate of the date shown.",
+	"Server baskets pick the cheapest x86 server with at least the stated vCPU and memory from general-purpose, compute- or memory-optimised ranges. Shared-core and burstable servers are excluded; vCPUs are compared one to one.",
+	"Server lists come from each provider's price API. Other unit prices come from data/manual.json, each with the page it was taken from.",
+}
+
+func build() error {
+	var fx FX
+	if err := readJSON(filepath.Join(dataDir, "sources", "fx.json"), &fx); err != nil {
+		return err
+	}
+	var manual struct {
+		Checked   string                    `json:"checked"`
+		Providers map[string]map[string]any `json:"providers"`
+	}
+	if err := readJSON(filepath.Join(dataDir, "manual.json"), &manual); err != nil {
+		return err
+	}
+	idx := &Index{Generated: today(), Currency: "EUR", License: "CC BY 4.0, MoveInfra (https://moveinfra.eu/)", Method: method,
+		Services: map[string]*Services{}, Servers: map[string][]Server{}}
+	idx.FX.Date, idx.FX.USDPerEUR, idx.FX.Source = fx.Date, fx.Rates["USD"], fx.Source
+
+	toEUR := func(v float64, currency string) float64 {
+		if currency == "" || currency == "EUR" {
+			return v
+		}
+		return v / fx.Rates[currency]
+	}
+
+	for _, p := range providerInfo {
+		var src Source
+		if err := readJSON(filepath.Join(dataDir, "sources", p.ID+".json"), &src); err != nil {
+			if !os.IsNotExist(err) {
+				return err
+			}
+			src = hetznerFromManual(manual.Providers[p.ID])
+			if len(src.Servers) == 0 {
+				return fmt.Errorf("no server list for %s: run pricegen fetch %s", p.ID, p.ID)
+			}
+		}
+		p.Region, p.Currency, p.Source, p.Fetched, p.Note = src.Region, src.Currency, src.Source, src.Generated, src.Note
+		idx.Providers = append(idx.Providers, p)
+		servers := make([]Server, 0, len(src.Servers))
+		for _, s := range src.Servers {
+			s.Monthly = round(toEUR(s.Monthly, src.Currency), 2)
+			servers = append(servers, s)
+		}
+		idx.Servers[p.ID] = servers
+		idx.Services[p.ID] = services(manual.Providers[p.ID], toEUR)
+	}
+	idx.Baskets = baskets(idx)
+
+	if err := writeJSON(filepath.Join(dataDir, "eu-cloud-prices.json"), idx); err != nil {
+		return err
+	}
+	if err := writeCSV(idx); err != nil {
+		return err
+	}
+	return writeReadme(idx, manual.Checked)
+}
+
+// hetznerFromManual is the fallback when no HCLOUD_TOKEN was available: the plan list checked by hand.
+func hetznerFromManual(m map[string]any) Source {
+	src := Source{Region: "fsn1", Currency: "EUR", Source: str(m, "hetznerServers", "source"), Generated: "manual",
+		Note: "Plan list checked by hand on the Hetzner website (no API token in this run). A primary IPv4 address is billed separately."}
+	list, _ := dig(m, "hetznerServers", "plans").([]any)
+	if list == nil {
+		list, _ = dig(m, "hetznerServers").([]any)
+	}
+	for _, it := range list {
+		e, _ := it.(map[string]any)
+		name := strings.ToUpper(fmt.Sprint(e["name"]))
+		cat := "shared"
+		if strings.HasPrefix(name, "CCX") {
+			cat = "general"
+		}
+		src.Servers = append(src.Servers, Server{Name: name, VCPU: num(e["vcpu"]), MemoryGiB: num(e["ramGB"], e["memoryGB"]),
+			Monthly: num(e["monthly"], e["monthlyEUR"], e["priceMonthly"]), Category: cat, Arch: "x86"})
+	}
+	return src
+}
+
+func services(m map[string]any, toEUR func(float64, string) float64) *Services {
+	unit := func(key, field string) *Unit {
+		obj, _ := m[key].(map[string]any)
+		v, ok := obj[field].(float64)
+		if !ok {
+			return nil
+		}
+		return &Unit{Price: round(toEUR(v, str(obj, "currency")), 4), Source: str(obj, "source"), Note: str(obj, "note"),
+			Product: firstNonEmpty(str(obj, "product"), str(obj, "plan"), str(obj, "tier"))}
+	}
+	s := &Services{
+		BlockStorageGBMonth:  unit("blockStorage", "perGBMonth"),
+		ObjectStorageGBMonth: unit("objectStorage", "perGBMonth"),
+		LoadBalancerMonthly:  unit("loadBalancer", "monthly"),
+		KubernetesMonthly:    unit("kubernetesControlPlane", "monthly"),
+		PostgresMonthly:      unit("managedPostgres", "monthly"),
+	}
+	if e, ok := m["egress"].(map[string]any); ok {
+		cur := str(e, "currency")
+		eg := &Egress{FreeGB: num(e["freeGBPerMonth"]), Source: str(e, "source"), Note: str(e, "note"),
+			PerServer: strings.Contains(lower(str(e, "freeScope")), "server")}
+		tiers, _ := e["tiers"].([]any)
+		for _, t := range tiers {
+			tm, _ := t.(map[string]any)
+			tier := Tier{FromGB: num(tm["fromGB"]), PerGB: round(toEUR(num(tm["perGB"]), cur), 4)}
+			if to, ok := tm["toGB"].(float64); ok {
+				tier.ToGB = &to
+			}
+			eg.Tiers = append(eg.Tiers, tier)
+		}
+		s.Egress = eg
+	}
+	return s
+}
+
+// egressCost prices gb of internet egress for a setup with the given number of servers.
+func egressCost(e *Egress, gb float64, servers int) (float64, bool) {
+	if e == nil {
+		return 0, false
+	}
+	free := e.FreeGB
+	if e.PerServer {
+		free *= float64(servers)
+	}
+	billable := math.Max(0, gb-free)
+	cost := 0.0
+	for _, t := range e.Tiers {
+		hi := math.Inf(1)
+		if t.ToGB != nil {
+			hi = *t.ToGB
+		}
+		if billable > t.FromGB {
+			cost += (math.Min(billable, hi) - t.FromGB) * t.PerGB
+		}
+	}
+	return cost, true
+}
+
+func cheapestServer(servers []Server, vcpu, mem float64) *Server {
+	var best *Server
+	for i, s := range servers {
+		if s.Arch != "x86" || s.VCPU < vcpu || s.MemoryGiB < mem ||
+			(s.Category != "general" && s.Category != "compute" && s.Category != "memory") {
+			continue
+		}
+		if best == nil || s.Monthly < best.Monthly {
+			best = &servers[i]
+		}
+	}
+	return best
+}
+
+func baskets(idx *Index) []Basket {
+	var out []Basket
+	add := func(id, label string, fn func(p string) *Price) {
+		b := Basket{ID: id, Label: label, Prices: map[string]*Price{}}
+		for _, p := range idx.Providers {
+			b.Prices[p.ID] = fn(p.ID)
+		}
+		out = append(out, b)
+	}
+	for _, size := range [][2]float64{{2, 8}, {4, 16}, {8, 32}, {16, 64}} {
+		add(fmt.Sprintf("server-%g-%g", size[0], size[1]), fmt.Sprintf("Server, %g vCPU, %g GB", size[0], size[1]), func(p string) *Price {
+			if s := cheapestServer(idx.Servers[p], size[0], size[1]); s != nil {
+				return &Price{Monthly: s.Monthly, Detail: s.Name}
+			}
+			return nil
+		})
+	}
+	times := func(get func(*Services) *Unit, n float64) func(string) *Price {
+		return func(p string) *Price {
+			if u := get(idx.Services[p]); u != nil {
+				return &Price{Monthly: round(u.Price*n, 2), Detail: u.Product}
+			}
+			return nil
+		}
+	}
+	add("block-1tb", "Block storage, 1 TB SSD", times(func(s *Services) *Unit { return s.BlockStorageGBMonth }, 1000))
+	add("object-1tb", "Object storage, 1 TB", times(func(s *Services) *Unit { return s.ObjectStorageGBMonth }, 1000))
+	for _, tb := range []float64{1, 10} {
+		add(fmt.Sprintf("egress-%gtb", tb), fmt.Sprintf("Internet egress, %g TB from one server", tb), func(p string) *Price {
+			if c, ok := egressCost(idx.Services[p].Egress, tb*1000, 1); ok {
+				return &Price{Monthly: round(c, 2), Detail: idx.Services[p].Egress.Note}
+			}
+			return nil
+		})
+	}
+	add("load-balancer", "Managed load balancer", times(func(s *Services) *Unit { return s.LoadBalancerMonthly }, 1))
+	add("kubernetes", "Managed Kubernetes control plane", times(func(s *Services) *Unit { return s.KubernetesMonthly }, 1))
+	add("postgres-2-8", "Managed PostgreSQL, 2 vCPU, 8 GB", times(func(s *Services) *Unit { return s.PostgresMonthly }, 1))
+
+	cell := func(id, p string) *Price {
+		for _, b := range out {
+			if b.ID == id {
+				return b.Prices[p]
+			}
+		}
+		return nil
+	}
+	// A small production setup, the kind most companies we talk to run.
+	add("stack", "Example stack", func(p string) *Price {
+		s := idx.Services[p]
+		srv, obj, lb := cell("server-4-16", p), cell("object-1tb", p), cell("load-balancer", p)
+		if srv == nil || s.BlockStorageGBMonth == nil || obj == nil || lb == nil {
+			return nil
+		}
+		eg, ok := egressCost(s.Egress, 2000, 3)
+		if !ok {
+			return nil
+		}
+		total := 3*srv.Monthly + 500*s.BlockStorageGBMonth.Price + obj.Monthly + eg + lb.Monthly
+		detail := "managed PostgreSQL"
+		if pg := cell("postgres-2-8", p); pg != nil {
+			total += pg.Monthly
+		} else if vm := cell("server-2-8", p); vm != nil {
+			total += vm.Monthly
+			detail = "no managed PostgreSQL: self-run on a 2 vCPU 8 GB server"
+		} else {
+			return nil
+		}
+		return &Price{Monthly: round(total, 2), Detail: detail}
+	})
+	return out
+}
+
+func writeCSV(idx *Index) error {
+	var buf bytes.Buffer
+	w := csv.NewWriter(&buf)
+	w.Write([]string{"basket", "label", "provider", "eu_owned", "monthly_eur", "detail"})
+	for _, b := range idx.Baskets {
+		for _, p := range idx.Providers {
+			if pr := b.Prices[p.ID]; pr != nil {
+				w.Write([]string{b.ID, b.Label, p.ID, fmt.Sprint(p.EUOwned), fmt.Sprintf("%.2f", pr.Monthly), pr.Detail})
+			} else {
+				w.Write([]string{b.ID, b.Label, p.ID, fmt.Sprint(p.EUOwned), "", "not offered or not verified"})
+			}
+		}
+	}
+	w.Flush()
+	path := filepath.Join(dataDir, "eu-cloud-prices.csv")
+	fmt.Println("wrote", path)
+	return os.WriteFile(path, buf.Bytes(), 0o644)
+}
+
+// writeReadme replaces the generated section of README.md.
+func writeReadme(idx *Index, checked string) error {
+	const start, end = "<!-- prices:start -->", "<!-- prices:end -->"
+	raw, err := os.ReadFile("README.md")
+	if err != nil {
+		return err
+	}
+	readme := string(raw)
+	i, j := strings.Index(readme, start), strings.Index(readme, end)
+	if i < 0 || j < i {
+		return fmt.Errorf("README.md has no %s ... %s section", start, end)
+	}
+	var b strings.Builder
+	b.WriteString(start + "\n")
+	fmt.Fprintf(&b, "_EUR per month, excluding VAT. Server prices fetched %s, other prices checked %s, USD at %.4f per EUR (ECB, %s). Lowest in bold._\n\n",
+		idx.Generated, checked, idx.FX.USDPerEUR, idx.FX.Date)
+	b.WriteString("| | ")
+	for _, p := range idx.Providers {
+		name := p.Name
+		if p.EUOwned {
+			name += " 🇪🇺"
+		}
+		b.WriteString(name + " | ")
+	}
+	b.WriteString("\n|---|" + strings.Repeat("--:|", len(idx.Providers)) + "\n")
+	for _, bk := range idx.Baskets {
+		label := bk.Label
+		if bk.ID == "stack" {
+			label = "**Example stack**¹"
+		}
+		b.WriteString("| " + label + " | ")
+		low := lowest(bk)
+		for _, p := range idx.Providers {
+			pr := bk.Prices[p.ID]
+			switch {
+			case pr == nil:
+				b.WriteString("– | ")
+			case pr.Monthly == 0:
+				b.WriteString("**included** | ")
+			case pr.Monthly == low:
+				fmt.Fprintf(&b, "**%s** | ", money(pr.Monthly))
+			default:
+				b.WriteString(money(pr.Monthly) + " | ")
+			}
+		}
+		b.WriteString("\n")
+	}
+	b.WriteString("\n¹ 3 servers with 4 vCPU and 16 GB, 500 GB block storage, 1 TB object storage, 2 TB internet egress, one load balancer and managed PostgreSQL with 2 vCPU and 8 GB. Where a provider has no managed PostgreSQL, the stack runs it on one more server.\n\n")
+	b.WriteString("<details><summary>Which server each basket picked</summary>\n\n| | ")
+	for _, p := range idx.Providers {
+		b.WriteString(p.Name + " | ")
+	}
+	b.WriteString("\n|---|" + strings.Repeat("---|", len(idx.Providers)) + "\n")
+	for _, bk := range idx.Baskets {
+		if !strings.HasPrefix(bk.ID, "server-") {
+			continue
+		}
+		b.WriteString("| " + bk.Label + " | ")
+		for _, p := range idx.Providers {
+			if pr := bk.Prices[p.ID]; pr != nil {
+				b.WriteString("`" + pr.Detail + "` | ")
+			} else {
+				b.WriteString("– | ")
+			}
+		}
+		b.WriteString("\n")
+	}
+	b.WriteString("\n</details>\n" + end)
+	readme = readme[:i] + b.String() + readme[j+len(end):]
+	fmt.Println("wrote README.md")
+	return os.WriteFile("README.md", []byte(readme), 0o644)
+}
+
+func lowest(b Basket) float64 {
+	low := math.Inf(1)
+	for _, p := range b.Prices {
+		if p != nil && p.Monthly < low {
+			low = p.Monthly
+		}
+	}
+	return low
+}
+
+func money(v float64) string {
+	if v >= 100 {
+		s := fmt.Sprintf("%.0f", v)
+		for i := len(s) - 3; i > 0; i -= 3 {
+			s = s[:i] + "," + s[i:]
+		}
+		return "€" + s
+	}
+	return fmt.Sprintf("€%.2f", v)
+}
+
+func dig(m map[string]any, keys ...string) any {
+	var cur any = m
+	for _, k := range keys {
+		mm, ok := cur.(map[string]any)
+		if !ok {
+			return nil
+		}
+		cur = mm[k]
+	}
+	return cur
+}
+
+func str(m map[string]any, keys ...string) string {
+	if v, ok := dig(m, keys...).(string); ok {
+		return v
+	}
+	return ""
+}
+
+func num(vs ...any) float64 {
+	for _, v := range vs {
+		if f, ok := v.(float64); ok {
+			return f
+		}
+	}
+	return 0
+}
+
+func firstNonEmpty(ss ...string) string {
+	for _, s := range ss {
+		if s != "" {
+			return s
+		}
+	}
+	return ""
+}
diff --git a/cmd/pricegen/eu.go b/cmd/pricegen/eu.go
new file mode 100644
index 0000000..e7a4893
--- /dev/null
+++ b/cmd/pricegen/eu.go
@@ -0,0 +1,221 @@
+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"os"
+	"strings"
+)
+
+// fetchUpCloud reads plans and Frankfurt prices from the UpCloud API (token in UPCLOUD_TOKEN, read access is enough).
+// Prices are in euro cents per hour; UpCloud caps a month at 672 billable hours.
+func fetchUpCloud() (*Source, error) {
+	const api = "https://api.upcloud.com/1.3"
+	h := http.Header{"Authorization": {"Bearer " + os.Getenv("UPCLOUD_TOKEN")}, "Accept": {"application/json"}}
+	var plans struct {
+		Plans struct {
+			Plan []struct {
+				Name   string `json:"name"`
+				Cores  int    `json:"core_number"`
+				Memory int    `json:"memory_amount"` // MiB
+				GPUs   int    `json:"gpu_amount"`
+			} `json:"plan"`
+		} `json:"plans"`
+	}
+	if err := getJSON(api+"/plan", h, &plans); err != nil {
+		return nil, err
+	}
+	var prices struct {
+		Prices struct {
+			Zone []map[string]json.RawMessage `json:"zone"`
+		} `json:"prices"`
+	}
+	if err := getJSON(api+"/price", h, &prices); err != nil {
+		return nil, err
+	}
+	src := &Source{Currency: "EUR", Source: api + "/price", Note: "Monthly price is 672 hours, UpCloud's monthly cap."}
+	for _, zone := range prices.Prices.Zone {
+		var name string
+		json.Unmarshal(zone["name"], &name)
+		if name != "de-fra1" {
+			continue
+		}
+		for _, p := range plans.Plans.Plan {
+			var it struct {
+				Price float64 `json:"price"`
+			}
+			raw, ok := zone["server_plan_"+p.Name]
+			if p.GPUs > 0 || !ok || json.Unmarshal(raw, &it) != nil || it.Price == 0 {
+				continue
+			}
+			src.Servers = append(src.Servers, Server{Name: p.Name, VCPU: float64(p.Cores), MemoryGiB: float64(p.Memory) / 1024,
+				Monthly: it.Price / 100 * 672, Category: upcloudCategory(p.Name), Arch: "x86"})
+		}
+	}
+	if len(src.Servers) == 0 {
+		return nil, fmt.Errorf("no de-fra1 plans in the API response")
+	}
+	return src, nil
+}
+
+func upcloudCategory(name string) string {
+	switch {
+	case strings.HasPrefix(name, "DEV-"):
+		return "shared"
+	case strings.HasPrefix(name, "HICPU-"):
+		return "compute"
+	case strings.HasPrefix(name, "HIMEM-"):
+		return "memory"
+	case strings.HasPrefix(name, "CLOUDNATIVE-"):
+		return "other"
+	}
+	return "general"
+}
+
+// fetchHetzner reads server types from the Hetzner Cloud API (token in HCLOUD_TOKEN, a read-only project token).
+func fetchHetzner() (*Source, error) {
+	h := http.Header{"Authorization": {"Bearer " + os.Getenv("HCLOUD_TOKEN")}}
+	var resp struct {
+		ServerTypes []struct {
+			Name         string  `json:"name"`
+			Cores        float64 `json:"cores"`
+			Memory       float64 `json:"memory"` // GB
+			CPUType      string  `json:"cpu_type"`
+			Architecture string  `json:"architecture"`
+			Deprecation  any     `json:"deprecation"`
+			Prices       []struct {
+				Location     string `json:"location"`
+				PriceMonthly struct {
+					Net string `json:"net"`
+				} `json:"price_monthly"`
+			} `json:"prices"`
+		} `json:"server_types"`
+	}
+	const url = "https://api.hetzner.cloud/v1/server_types?per_page=50"
+	if err := getJSON(url, h, &resp); err != nil {
+		return nil, err
+	}
+	src := &Source{Currency: "EUR", Source: url, Note: "Net prices. A primary IPv4 address is billed separately."}
+	for _, t := range resp.ServerTypes {
+		if t.Deprecation != nil {
+			continue
+		}
+		for _, p := range t.Prices {
+			var monthly float64
+			if p.Location != "fsn1" || parseFloat(p.PriceMonthly.Net, &monthly) != nil {
+				continue
+			}
+			cat := "general"
+			if t.CPUType == "shared" {
+				cat = "shared"
+			}
+			arch := "x86"
+			if t.Architecture == "arm" {
+				arch = "arm"
+			}
+			src.Servers = append(src.Servers, Server{Name: strings.ToUpper(t.Name), VCPU: t.Cores, MemoryGiB: t.Memory,
+				Monthly: monthly, Category: cat, Arch: arch})
+		}
+	}
+	return src, nil
+}
+
+// fetchScaleway reads the public Instance product list for Paris 1.
+func fetchScaleway() (*Source, error) {
+	const base = "https://api.scaleway.com/instance/v1/zones/fr-par-1/products/servers"
+	src := &Source{Currency: "EUR", Source: base}
+	for page := 1; ; page++ {
+		var resp struct {
+			Servers map[string]struct {
+				NCPUs        float64 `json:"ncpus"`
+				RAM          float64 `json:"ram"` // bytes
+				GPU          int     `json:"gpu"`
+				Arch         string  `json:"arch"`
+				MonthlyPrice float64 `json:"monthly_price"`
+				EndOfService bool    `json:"end_of_service"`
+			} `json:"servers"`
+		}
+		if err := getJSON(fmt.Sprintf("%s?per_page=100&page=%d", base, page), nil, &resp); err != nil {
+			return nil, err
+		}
+		for name, s := range resp.Servers {
+			if s.GPU > 0 || s.EndOfService || s.MonthlyPrice <= 0 {
+				continue
+			}
+			arch := "x86"
+			if s.Arch == "arm64" {
+				arch = "arm"
+			}
+			src.Servers = append(src.Servers, Server{Name: name, VCPU: s.NCPUs, MemoryGiB: s.RAM / (1 << 30),
+				Monthly: s.MonthlyPrice, Category: scalewayCategory(name), Arch: arch})
+		}
+		if len(resp.Servers) < 100 {
+			return src, nil
+		}
+	}
+}
+
+func scalewayCategory(name string) string {
+	switch {
+	case strings.HasPrefix(name, "DEV1") || strings.HasPrefix(name, "PLAY2") || strings.HasPrefix(name, "STARDUST") ||
+		strings.HasPrefix(name, "START1") || strings.HasPrefix(name, "VC1") || strings.HasPrefix(name, "BASIC"):
+		return "shared"
+	case strings.Contains(name, "-HC-") || strings.HasPrefix(name, "COMPUTE"):
+		return "compute"
+	case strings.Contains(name, "-HM-") || strings.HasPrefix(name, "MEMORY"):
+		return "memory"
+	case strings.HasPrefix(name, "X64") || strings.HasPrefix(name, "ARM64") || strings.Contains(name, "-HN-"):
+		return "other"
+	}
+	return "general"
+}
+
+// fetchOVH reads the public Public Cloud catalogue (German subsidiary, EUR, net prices) and keeps hourly-billed
+// Linux instances of the current ranges. OVHcloud prices most instances the same in all European regions.
+func fetchOVH() (*Source, error) {
+	const url = "https://eu.api.ovh.com/v1/order/catalog/public/cloud?ovhSubsidiary=DE"
+	var cat struct {
+		Addons []struct {
+			PlanCode string `json:"planCode"`
+			Product  string `json:"product"`
+			Pricings []struct {
+				Price float64 `json:"price"` // 1e-8 EUR
+			} `json:"pricings"`
+			Blobs struct {
+				Commercial struct {
+					BrickSubtype string `json:"brickSubtype"`
+					Name         string `json:"name"`
+				} `json:"commercial"`
+				Technical struct {
+					CPU struct {
+						Cores float64 `json:"cores"`
+					} `json:"cpu"`
+					Memory struct {
+						Size float64 `json:"size"`
+					} `json:"memory"`
+				} `json:"technical"`
+			} `json:"blobs"`
+		} `json:"addons"`
+	}
+	if err := getJSON(url, nil, &cat); err != nil {
+		return nil, err
+	}
+	src := &Source{Currency: "EUR", Source: url, Note: "Hourly price x 730. OVHcloud also offers cheaper monthly billing for some ranges."}
+	cats := map[string]string{"general-purpose": "general", "cpu": "compute", "ram": "memory", "iops": "storage", "discovery": "shared"}
+	for _, a := range cat.Addons {
+		c, ok := cats[a.Blobs.Commercial.BrickSubtype]
+		if a.Product != "publiccloud-instance" || !ok || !strings.HasSuffix(a.PlanCode, ".consumption") ||
+			strings.HasPrefix(a.PlanCode, "win-") || len(a.Pricings) == 0 || a.Blobs.Technical.CPU.Cores == 0 {
+			continue
+		}
+		src.Servers = append(src.Servers, Server{Name: a.Blobs.Commercial.Name, VCPU: a.Blobs.Technical.CPU.Cores,
+			MemoryGiB: a.Blobs.Technical.Memory.Size, Monthly: a.Pricings[0].Price / 1e8 * hoursPerMonth, Category: c, Arch: "x86"})
+	}
+	return src, nil
+}
+
+func parseFloat(s string, f *float64) error {
+	_, err := fmt.Sscan(s, f)
+	return err
+}
