@@ -0,0 +1,30 @@
+name: Price correction
+description: A price in the index is wrong or out of date
+labels: [price]
+body:
+  - type: input
+    id: provider
+    attributes:
+      label: Provider
+      placeholder: Scaleway
+    validations:
+      required: true
+  - type: input
+    id: item
+    attributes:
+      label: Basket or price
+      placeholder: Object storage, 1 TB
+    validations:
+      required: true
+  - type: textarea
+    id: change
+    attributes:
+      label: What the index says, and what it should say
+    validations:
+      required: true
+  - type: input
+    id: source
+    attributes:
+      label: Link to the provider's price page
+    validations:
+      required: true
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
new file mode 100644
index 0000000..3a6fb03
--- /dev/null
+++ b/.github/workflows/ci.yml
@@ -0,0 +1,32 @@
+name: CI
+on:
+  push:
+    branches: [main]
+  pull_request: {}
+
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v5
+      - uses: actions/setup-go@v6
+        with:
+          go-version-file: go.mod
+      - run: go vet ./...
+      - run: go test ./...
+      - name: Data is valid JSON with sources
+        run: |
+          python3 - <<'PY'
+          import json, sys
+          d = json.load(open("data/eu-cloud-prices.json"))
+          m = json.load(open("data/manual.json"))
+          errors = []
+          for p, items in m["providers"].items():
+              for k, v in items.items():
+                  if isinstance(v, dict) and any(isinstance(x, (int, float)) for x in v.values()) and not v.get("source"):
+                      errors.append(f"manual.json {p}.{k}: number without source")
+          if len(d["providers"]) != 7:
+              errors.append("expected 7 providers")
+          print("\n".join(errors) or "data OK")
+          sys.exit(1 if errors else 0)
+          PY
diff --git a/.github/workflows/prices.yml b/.github/workflows/prices.yml
new file mode 100644
index 0000000..0b25772
--- /dev/null
+++ b/.github/workflows/prices.yml
@@ -0,0 +1,35 @@
+# Refreshes the index monthly and opens a pull request with the changes.
+name: Refresh prices
+on:
+  schedule:
+    - cron: '0 5 3 * *'
+  workflow_dispatch: {}
+
+permissions:
+  contents: write
+  pull-requests: write
+
+jobs:
+  prices:
+    runs-on: ubuntu-latest
+    timeout-minutes: 60
+    env:
+      UPCLOUD_TOKEN: ${{ secrets.UPCLOUD_TOKEN }}
+      HCLOUD_TOKEN: ${{ secrets.HCLOUD_TOKEN }}
+    steps:
+      - uses: actions/checkout@v5
+      - uses: actions/setup-go@v6
+        with:
+          go-version-file: go.mod
+      - run: go run ./cmd/pricegen fetch all
+      - run: go run ./cmd/pricegen build
+      - run: go test ./...
+      - uses: peter-evans/create-pull-request@v7
+        with:
+          branch: prices/refresh
+          commit-message: "prices: monthly refresh"
+          title: "Monthly price refresh"
+          body: |
+            Regenerated by `cmd/pricegen` from the providers' price APIs and ECB rates.
+            Before merging: compare the README table with last month and check any change over 10%.
+            `data/manual.json` is not refreshed automatically; check its `checked` date.
