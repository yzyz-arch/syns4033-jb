diff --git a/templates/install.html b/templates/install.html
new file mode 100644
index 0000000..a956c02
--- /dev/null
+++ b/templates/install.html
@@ -0,0 +1,90 @@
+{% extends "base.html" %}
+{% block title %}Install baru — RDP Installer{% endblock %}
+
+{% block topnav %}
+<div class="topnav">
+  <a class="btn ghost small" href="/">dashboard</a>
+  <span class="who">{{ user.display_name() }}</span>
+</div>
+{% endblock %}
+
+{% block content %}
+<section class="card">
+  <div class="cardhead">
+    <h2>Install RDP baru</h2>
+    <span class="muted small">tarif {{ rupiah(price) }} · saldo {{ rupiah(balance) }}</span>
+  </div>
+
+  {% if !error.is_empty() %}<p class="alert">{{ error }}</p>{% endif %}
+
+  {% if accounts.is_empty() %}
+  <p class="empty">Belum ada akun cloud yang valid. <a href="/cloud">Tambahkan API token UpCloud</a> dulu.</p>
+  {% else %}
+  <p class="muted small">Server dibuat dari template Windows resmi UpCloud. UpCloud menyerahkan
+  password Administrator sekali di respons pembuatan — kami simpan terenkripsi dan menghapusnya
+  otomatis setelah 24 jam. Biaya lisensi Windows sudah termasuk di harga plan UpCloud dan
+  ditagih ke akun cloud Anda, bukan ke saldo di sini.</p>
+
+  <form method="post" action="/install" class="form">
+    <label>
+      <span class="label">Windows</span>
+      <select name="template_uuid" required>
+        {% for t in templates %}
+        <option value="{{ t.uuid }}">{{ t.title }}{% if t.size > 0 %} · min {{ t.size }} GB{% endif %}{% if t.license > 0.0 %} · lisensi {{ t.license }}{% endif %}</option>
+        {% endfor %}
+      </select>
+    </label>
+
+    <label>
+      <span class="label">Akun cloud</span>
+      <select name="account_id" required>
+        {% for a in accounts %}
+        <option value="{{ a.id }}">{{ a.label }} — {{ a.credit }}</option>
+        {% endfor %}
+      </select>
+    </label>
+
+    <label>
+      <span class="label">Lokasi</span>
+      <select name="zone" required>
+        {% for z in zones %}
+        <option value="{{ z.id }}">{{ z.id }} — {{ z.description }}</option>
+        {% endfor %}
+      </select>
+    </label>
+
+    <label>
+      <span class="label">Plan</span>
+      <select name="plan" required>
+        {% for p in plans %}
+        <option value="{{ p.name }}">{{ p.label() }}{% if !p.fits_windows_11() %} · di bawah 2 GB, pilih edisi ringan{% endif %}</option>
+        {% endfor %}
+      </select>
+    </label>
+
+    <label>
+      <span class="label">Ukuran disk (GB, opsional)</span>
+      <input type="number" name="storage_gb" min="0" max="500" placeholder="ikut template" inputmode="numeric">
+    </label>
+
+    <label>
+      <span class="label">Nama server (opsional)</span>
+      <input type="text" name="title" maxlength="60" placeholder="RDP Jay" autocomplete="off">
+    </label>
+
+    <div class="row"><button class="btn" type="submit">buat &amp; install</button>
+      <span class="muted small">saldo terpotong {{ rupiah(price) }} saat server berhasil dibuat</span></div>
+  </form>
+  {% endif %}
+</section>
+
+<section class="card">
+  <h2>Yang terjadi setelah ini</h2>
+  <ol class="steps">
+    <li>UpCloud membuat server dari template Windows (30-60 detik).</li>
+    <li>Kami pantau state server lewat API, lalu menunggu port 3389 benar-benar menjawab.</li>
+    <li>Kredensial muncul di halaman job — IP, user, password, tombol salin.</li>
+    <li>Ada tombol <span class="mono">hancurkan server</span> kalau sudah tidak dipakai.</li>
+  </ol>
+</section>
+{% endblock %}
diff --git a/templates/job.html b/templates/job.html
new file mode 100644
index 0000000..bd7597a
--- /dev/null
+++ b/templates/job.html
@@ -0,0 +1,51 @@
+{% extends "base.html" %}
+{% block title %}Job #{{ card.job.id }} — RDP Installer{% endblock %}
+
+{% block topnav %}
+<div class="topnav">
+  <a class="btn ghost small" href="/">dashboard</a>
+  <a class="btn ghost small" href="/install">install baru</a>
+</div>
+{% endblock %}
+
+{% block content %}
+<noscript>
+  <p class="alert">JavaScript dimatikan — progres tidak akan berubah sendiri. Muat ulang halaman untuk memperbarui.</p>
+</noscript>
+
+<div id="jobcard">
+  <section class="card">
+    <div class="cardhead">
+      <h2>Job #{{ card.job.id }} · {{ card.job.os_label }}</h2>
+      <span class="badge {{ card.job.status_class() }}">{{ card.job.status }}</span>
+    </div>
+    <p class="muted">{{ card.job.phase }}</p>
+    {% if card.job.status == "done" %}
+    <p class="mono">{{ card.job.host }}:{{ card.job.rdp_port }} · {{ card.job.rdp_user }}</p>
+    {% endif %}
+  </section>
+</div>
+
+<script>
+(function () {
+  var box = document.getElementById("jobcard");
+  var es = new EventSource("/jobs/{{ card.job.id }}/events");
+  es.addEventListener("card", function (ev) {
+    box.innerHTML = ev.data;
+    var btn = box.querySelector("[data-copy]");
+    if (btn && !btn.dataset.bound) {
+      btn.dataset.bound = "1";
+      btn.addEventListener("click", function () {
+        var el = document.getElementById(btn.dataset.copy);
+        if (!el) return;
+        navigator.clipboard.writeText(el.textContent.trim()).then(function () {
+          btn.textContent = "tersalin";
+          setTimeout(function () { btn.textContent = "salin"; }, 1500);
+        });
+      });
+    }
+  });
+  es.onerror = function () { es.close(); };
+})();
+</script>
+{% endblock %}
diff --git a/templates/job_card.html b/templates/job_card.html
new file mode 100644
index 0000000..b9a2a03
--- /dev/null
+++ b/templates/job_card.html
@@ -0,0 +1,63 @@
+<section class="card">
+  <div class="cardhead">
+    <h2>Job #{{ job.id }} · {{ job.os_label }}</h2>
+    <span class="badge {{ job.status_class() }}">{{ job.status }}</span>
+  </div>
+
+  <div class="bar"><span style="width: {{ job.progress }}%"></span></div>
+  <p class="muted">{{ job.phase }}{% if job.is_active() %} <span class="mono">{{ job.progress }}%</span>{% endif %}</p>
+
+  <div class="kv">
+    <div><span class="k">Lokasi</span><span class="v mono">{{ job.zone }}</span></div>
+    <div><span class="k">Plan</span><span class="v mono">{{ job.plan }}</span></div>
+    <div><span class="k">Dibuat</span><span class="v">{{ dt(job.created_at) }}</span></div>
+    {% if job.done_at > 0 %}<div><span class="k">RDP siap</span><span class="v">{{ dt(job.done_at) }}</span></div>{% endif %}
+  </div>
+
+  {% if !job.error.is_empty() %}
+  <p class="alert">{{ job.error }}</p>
+  {% endif %}
+
+  {% if job.status == "done" %}
+  <div class="creds">
+    <div class="cred"><span class="k">IP</span><span class="v mono" id="hv">{{ job.host }}</span><button class="btn ghost small" data-copy="hv">salin</button></div>
+    <div class="cred"><span class="k">Port</span><span class="v mono" id="pv">{{ job.rdp_port }}</span><button class="btn ghost small" data-copy="pv">salin</button></div>
+    <div class="cred"><span class="k">User</span><span class="v mono" id="uv">{{ job.rdp_user }}</span><button class="btn ghost small" data-copy="uv">salin</button></div>
+    {% if let Some(pw) = password %}
+    <div class="cred"><span class="k">Password</span><span class="v mono" id="pwv">{{ pw }}</span><button class="btn ghost small" data-copy="pwv">salin</button></div>
+    {% endif %}
+    {% if let Some(pw) = password %}
+    <p class="muted small">Password hilang otomatis {{ dt(job.expires_at) }}. Ganti setelah login pertama.</p>
+    {% else %}
+    {% if job.wiped == 1 %}
+    <p class="muted small">Password sudah dihapus karena masa simpan habis. Reset lewat panel UpCloud bila perlu.</p>
+    {% else %}
+    <p class="muted small">UpCloud tidak mengirim password di respons create — setel ulang lewat panel UpCloud.</p>
+    {% endif %}
+    {% endif %}
+  </div>
+  {% endif %}
+
+  {% if !events.is_empty() %}
+  <div class="log">
+    {% for e in events %}
+    <div class="logline"><span class="dim">{{ dt(e.ts) }}</span> <span class="mono">{{ e.phase }}</span>
+      {% if !e.message.is_empty() %}<span class="dim">{{ e.message }}</span>{% endif %}</div>
+    {% endfor %}
+  </div>
+  {% endif %}
+
+  <div class="row">
+    {% if job.status == "done" || job.status == "failed" %}
+    {% if job.status == "done" %}
+    <form method="post" action="/jobs/{{ job.id }}/destroy"
+          onsubmit="return confirm('Hapus server di UpCloud? Tindakan ini tidak bisa dibatalkan.');">
+      <button class="btn ghost small" type="submit">hancurkan server</button>
+    </form>
+    {% endif %}
+    <a class="btn ghost small" href="/install">install baru</a>
+    {% else %}
+    <span class="muted small">biarkan tab ini terbuka — status diperbarui otomatis.</span>
+    {% endif %}
+  </div>
+</section>
