+                    return CoreCloudRestore.Status.COMPLETE
+                elif request.data.lifecycle_state == Volume.LIFECYCLE_STATE_FAULTY:
+                    return CoreCloudRestore.Status.FAILED
+        return CoreCloudRestore.Status.IN_PROGRESS
