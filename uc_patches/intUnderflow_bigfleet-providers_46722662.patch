+func newRealWithMock(m *mockService) *upcloudReal {
+	return &upcloudReal{cfg: upcloudRealConfig{Username: "u", Password: "p", Zone: "fi-hel1", Template: "tpl"}, svc: m, log: quietLogger()}
+}
