+	}
+	return credentials, nil
+}
+
+func (c *Client) CreateScalewaySSHKeyCredential(createRequest CreateSSHKeyCredentialRequest) (*CreateSSHKeyCredentialResponse, error) {
+	url := c.BaseURL + "/api/v1/credentials/scaleway/ssh-key"
