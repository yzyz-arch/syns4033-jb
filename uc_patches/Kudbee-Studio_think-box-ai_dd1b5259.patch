     memory: { counts: memoryStore.counts(), vector: memoryStore.vectorStatus },
@@ -1164,12 +1175,22 @@ app.get('/api/stats', (_req: Request, res: Response) => {
       load_avg: os.loadavg().map((load) => Math.round(load * 100) / 100),
