+  const data = { runs: runStore.list(limit).map((run) => ({ ...run, steps: undefined, step_count: run.steps.length })) };
+  runsListCache = { data, at: now };
+  res.json(data);
 });
 
 app.get('/api/runs/:id', (req: Request, res: Response) => {
