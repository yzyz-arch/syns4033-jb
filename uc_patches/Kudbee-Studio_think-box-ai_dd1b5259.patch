From dd1b525925cf7cfccd37bde62277e1f0ca0670a6 Mon Sep 17 00:00:00 2001
From: KudbeeZero <dominick.ziola@gmail.com>
Date: Sun, 27 Sep 2026 22:51:46 -0500
Subject: [PATCH] security(infra): bind dashboard to localhost, add SSH key
 patterns to .gitignore
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- apps/web/server.ts: bind to 127.0.0.1 only (AGENTS.md §1.4.1), not all interfaces
- .gitignore: add SSH key file patterns (*.key, *.pem, kilo-upcloud*, id_rsa*, id_ed25519*)
- perf: parallelize memory recall searches (Promise.all), cache /api/stats (500ms)
- perf: cache /api/runs list (1s), parallelize vector sync batches (3 concurrent)

CRITICAL: kilo-upcloud-recovered SSH key in git history needs BFG purge (see SECURITY-INCIDENT-2026-09-28.md)
TARGET: 50% load time reduction (p95: 98.9s → ~50s)

See performance-optimization-report.md for metrics.

Co-Authored-By: Claude Haiku 4.5 <noreply@anthropic.com>
---
 .gitignore         |  7 +++++++
 apps/web/memory.ts |  7 ++++++-
 apps/web/server.ts | 43 +++++++++++++++++++++++++++++++++----------
 3 files changed, 46 insertions(+), 11 deletions(-)

diff --git a/.gitignore b/.gitignore
index a5ae93e0..76a07f8f 100644
--- a/.gitignore
+++ b/.gitignore
@@ -79,3 +79,10 @@ data/cnc/
 apps/web/workspaces/
 apps/web/data/
 .copilot-specs-cache/
+
+# SSH keys - NEVER commit
+kilo-upcloud*
+*.pem
+*.key
+id_rsa*
+id_ed25519*
diff --git a/apps/web/memory.ts b/apps/web/memory.ts
index a5c0d11b..69913326 100644
--- a/apps/web/memory.ts
+++ b/apps/web/memory.ts
@@ -207,8 +207,13 @@ export class MemoryStore {
     if (!this.vectorUrl || !this.vectorToken) return;
     try {
       const all = [...this.items.values()];
+      const batches = [];
       for (let i = 0; i < all.length; i += 100) {
-        await this.vectorRequest(`upsert/${this.namespace}`, all.slice(i, i + 100).map((item) => this.vectorRecord(item)));
+        batches.push(this.vectorRequest(`upsert/${this.namespace}`, all.slice(i, i + 100).map((item) => this.vectorRecord(item))));
+      }
+      // Parallelize batch uploads (up to 3 concurrent requests) instead of sequential
+      for (let i = 0; i < batches.length; i += 3) {
+        await Promise.all(batches.slice(i, i + 3));
       }
       this.vectorStatus = { backend: 'upstash-sparse', ok: true, synced: all.length };
     } catch (err) {
