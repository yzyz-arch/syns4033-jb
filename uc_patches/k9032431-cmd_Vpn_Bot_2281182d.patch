 README.md                 | 21 +++++++++-------
 bot/handlers/cloud.py     |  6 +++--
 bot/texts/cloud.py        |  7 ++++--
 bot/texts/translations.py | 52 ++++++++++++++++++++++++---------------
 4 files changed, 53 insertions(+), 33 deletions(-)

diff --git a/README.md b/README.md
index e696422..571f128 100644
--- a/README.md
+++ b/README.md
@@ -230,15 +230,18 @@ URL API. Если панель развёрнута под собственны
 пока полноценно реализован **UpCloud**, остальные показаны как "скоро" и
 не мешают выбору активного провайдера.
 
-Подключение аккаунта UpCloud происходит так же, как подключение панели:
-бот просит **логин и пароль** — можно вводить данные основного аккаунта
-UpCloud (тот же username, которым вы входите на upcloud.com), отдельный
-суб-аккаунт не обязателен. Единственное жёсткое требование самого API
-UpCloud (не бота): у аккаунта должна быть включена опция *«Permit API
-connections»* (Account → Account settings) и выключена двухфакторная
-аутентификация — если на аккаунте есть 2FA, нужно завести отдельного
-пользователя без неё в разделе *People*. Один пользователь бота может
-подключить несколько аккаунтов UpCloud.
+Подключение аккаунта UpCloud выглядит как обычный вход на сайт: бот
+просто просит **логин и пароль** от аккаунта upcloud.com, никаких
+отдельных суб-аккаунтов создавать не нужно, и никаких предупреждений
+на этом экране бот не показывает. Единственное жёсткое требование
+самого API UpCloud (не бота) — на аккаунте должна быть включена опция
+*«Permit API connections»* (Account → Account settings), а двухфакторная
+аутентификация выключена: без этого UpCloud отклоняет вход по API даже с
+верным паролем. Бот не заставляет включать это заранее — если вход не
+получился, он покажет обычную ошибку "неверный логин или пароль" и
+только тогда, отдельной строкой, подскажет про эту настройку и 2FA как
+вероятную причину. Один пользователь бота может подключить несколько
+аккаунтов UpCloud.
 
 После подключения аккаунта доступно управление сервером почти один в
 один как на самом сайте UpCloud:
diff --git a/bot/handlers/cloud.py b/bot/handlers/cloud.py
index f4375a0..92355bf 100644
--- a/bot/handlers/cloud.py
+++ b/bot/handlers/cloud.py
@@ -204,12 +204,14 @@ async def process_password(message: Message, state: FSMContext, lang: str) -> No
         await _login(data["provider"], data["username"], password)
     except UpCloudAPIError as exc:
         await state.clear()
-        await status_message.edit_text(texts.login_error_text(lang, str(exc)), reply_markup=cloud_error_keyboard(lang))
+        await status_message.edit_text(
+            texts.login_error_text(lang, str(exc), data["provider"]), reply_markup=cloud_error_keyboard(lang)
+        )
         return
     except Exception:  # noqa: BLE001 - surface unexpected errors to the user
         await state.clear()
         await status_message.edit_text(
-            texts.login_error_text(lang, "bad_response"), reply_markup=cloud_error_keyboard(lang)
+            texts.login_error_text(lang, "bad_response", data["provider"]), reply_markup=cloud_error_keyboard(lang)
         )
         return
 
diff --git a/bot/texts/cloud.py b/bot/texts/cloud.py
index 4596b47..ffd0676 100644
--- a/bot/texts/cloud.py
+++ b/bot/texts/cloud.py
@@ -76,8 +76,11 @@ def _error_reason(lang: str, reason: str) -> str:
     return t(lang, key)
 
 
-def login_error_text(lang: str, reason: str) -> str:
-    return t(lang, "cloud_login_error", icon=e("error", "❌"), reason=_error_reason(lang, reason))
+def login_error_text(lang: str, reason: str, provider: str | None = None) -> str:
+    error_text = _error_reason(lang, reason)
+    if reason == "wrong_credentials" and provider == "upcloud":
+        error_text += t(lang, "cloud_err_wrong_credentials_hint_upcloud")
+    return t(lang, "cloud_login_error", icon=e("error", "❌"), reason=error_text)
 
 
 def action_error_text(lang: str, reason: str) -> str:
