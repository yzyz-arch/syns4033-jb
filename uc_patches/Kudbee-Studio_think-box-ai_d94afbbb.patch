+        self.artifact_hash = _sha256_file(self.artifact_path)
+
+    def receipt(self, **overrides: object) -> dict:
+        receipt = {
+            "job_id": "engine_test0001",
+            "execution_id": "exec_test0001",
+            "provider": "upcloud-ssh",
