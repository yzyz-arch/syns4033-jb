From 7b353bf0542e9060e612dd19c11c145ec17bb362 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 21 Oct 2026 10:31:33 +0000
Subject: [PATCH] upctl-nodes.sh, README: the token from a file, the README's
 node creation through the script

upctl account login --with-token reads stdin without a prompt and uses
the keyring (experimental in upctl); it looked stuck on the laptop.  The
token now lives in ~/.config/upcloud-token (mode 600) and reaches upctl
as UPCLOUD_TOKEN, like /root/s3-secret on the servers.  The README's
'Creating a node' runs the script; the console way stays as the fallback.

Checked on the laptop against UpCloud (2026-10-21): check found the hub's
plan STARTER-4xCPU-8GB and the one Ubuntu 26.04 template.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01KXedtR8HsZaBZAcKmeSzEv
---
 scripts/gate-cloud/README.md      | 42 +++++++++++++++++++------------
 scripts/gate-cloud/upctl-nodes.sh | 12 ++++++---
 2 files changed, 34 insertions(+), 20 deletions(-)

diff --git a/scripts/gate-cloud/README.md b/scripts/gate-cloud/README.md
index bb8c14a..b6997ed 100644
--- a/scripts/gate-cloud/README.md
+++ b/scripts/gate-cloud/README.md
@@ -174,22 +174,32 @@ FI-HEL2); every address below is a utility address.
 
 ## Creating a node
 
-1. Console → **Deploy server**: Ubuntu 26.04 (kernel 7.0 has ublk), the
-   same plan as taso-test, zone FI-HEL1, your SSH key.  Click deploy
-   **once** and check the server list afterwards: the button fired twice
-   on 2026-10-20, and the duplicates bill hourly too.
-2. From the hub, note the node's utility address and check you can log in
-   (the prompt still shows the image's hostname until the role sets it):
-   ```
-   ssh root@<node public ip> 'ip -br -4 addr | grep " 10\."; uname -r'
-   ```
-3. On the node, first the security updates (a fresh image predates them:
-   the emSign root removed from `ca-certificates`, 2026-10-21), then the
-   repo:
-   ```
-   apt-get update -q && apt-get upgrade -y -q
-   git clone https://github.com/Suo-commerce/taso.git /root/taso
-   ```
+From the laptop, with `scripts/gate-cloud/upctl-nodes.sh` (UpCloud's CLI
+`upctl` and `jq` installed; the API token from UpCloud Hub → API tokens in
+`~/.config/upcloud-token`, mode 600):
+```
+export UPCLOUD_TOKEN=$(cat ~/.config/upcloud-token)
+scripts/gate-cloud/upctl-nodes.sh check        # read-only: plan, template, key
+scripts/gate-cloud/upctl-nodes.sh create a b   # taso-a, taso-b
+```
+It creates each node with the hub's plan, Ubuntu 26.04 and your key, and
+a first-boot script that installs the security updates (a fresh image
+predates them: the emSign root removed from `ca-certificates`,
+2026-10-21).  It refuses a name that exists and checks that exactly one
+server was made (the console's deploy button fired twice on 2026-10-20).
+It prints each node's public and utility address.  `list` shows the gate
+nodes; `delete a b` shows what it would delete, `delete --yes a b`
+deletes them (gate nodes only, by UUID; the hub never).
+
+Then, on each node, the repo:
+```
+git clone https://github.com/Suo-commerce/taso.git /root/taso
+```
+
+By hand instead (the console): Deploy server, Ubuntu 26.04, the hub's
+plan, FI-HEL1, your SSH key; click deploy **once** and check the server
+list for duplicates; on the node `apt-get update -q && apt-get upgrade -y
+-q` before anything else.
 
 ## Setting up (as root, from `/root/taso`)
 
diff --git a/scripts/gate-cloud/upctl-nodes.sh b/scripts/gate-cloud/upctl-nodes.sh
index 80ff9bd..69c2039 100755
--- a/scripts/gate-cloud/upctl-nodes.sh
+++ b/scripts/gate-cloud/upctl-nodes.sh
@@ -3,15 +3,19 @@
 # taso-b, ...) from a terminal instead of the console.  Runs where your
 # UpCloud credentials are (the laptop), never on a gate node.
 #
+#   export UPCLOUD_TOKEN=$(cat ~/.config/upcloud-token)
 #   scripts/gate-cloud/upctl-nodes.sh check
 #   scripts/gate-cloud/upctl-nodes.sh create a b       # taso-a, taso-b
 #   scripts/gate-cloud/upctl-nodes.sh list
 #   scripts/gate-cloud/upctl-nodes.sh delete a b       # shows what it would delete
 #   scripts/gate-cloud/upctl-nodes.sh delete --yes a b # deletes them
 #
-# Needs upctl (UpCloud's CLI, 3.x) logged in, either `upctl account login
-# --with-token` (system keyring) or UPCLOUD_TOKEN in the environment, and
-# jq.  The token never goes to a node, the repo or a chat.
+# Needs upctl (UpCloud's CLI, 3.x; 3.37.0 checked) and jq.  The API token
+# (UpCloud Hub -> API tokens) lives in ~/.config/upcloud-token, mode 600,
+# and is given to upctl as UPCLOUD_TOKEN: it never goes to a node, the repo
+# or a chat.  (`upctl account login --with-token` also works, but it reads
+# the token from stdin without a prompt and stores it in the system
+# keyring, marked experimental in upctl; on 2026-10-21 it looked stuck.)
 #
 # What it does, and why (lessons of 2026-10-20/21):
 #   create  One server per name: hostname taso-<name>, title "taso gate
@@ -66,7 +70,7 @@ preflight() {
     command -v "$UPCTL" >/dev/null || die "upctl not found (UpCloud's CLI: github.com/UpCloudLtd/upcloud-cli)"
     command -v jq >/dev/null || die "jq not found"
     "$UPCTL" version >/dev/null 2>&1 || die "upctl does not run"
-    "$UPCTL" account show >/dev/null 2>&1 || die "upctl is not logged in: upctl account login --with-token (or set UPCLOUD_TOKEN)"
+    "$UPCTL" account show >/dev/null 2>&1 || die "upctl has no credentials: export UPCLOUD_TOKEN=\$(cat ~/.config/upcloud-token)"
 }
 
 resolve_plan() {
