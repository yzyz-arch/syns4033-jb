+        assert {
+            "private_ip_address",
+            "private_ip_cidr",
+            "private_ip_assignment_type",
+            "private_ip_formula",
+        }.issubset(keys)
+
+    def test_unique_keys(self):
+        keys = [f.key for f in MARKER_HOST_FIELDS]
+        assert len(keys) == len(set(keys))
+
