 .../app/Jobs/TaskVms/SweepTaskVmHosts.php     |  9 ++--
 apps/gateway/bootstrap/app.php                | 10 +++-
 .../tests/Feature/TaskVms/TaskVmSweepTest.php | 17 +++++-
 4 files changed, 80 insertions(+), 8 deletions(-)
