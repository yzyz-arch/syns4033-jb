diff --git a/apps/gateway/app/Jobs/TaskVms/RefreshUpCloudTaskVmTemplate.php b/apps/gateway/app/Jobs/TaskVms/RefreshUpCloudTaskVmTemplate.php
new file mode 100644
index 0000000000..ee28920c2a
--- /dev/null
+++ b/apps/gateway/app/Jobs/TaskVms/RefreshUpCloudTaskVmTemplate.php
@@ -0,0 +1,52 @@
+<?php
+
+declare(strict_types=1);
+
+namespace App\Jobs\TaskVms;
+
+use App\Domain\TaskVms\TaskVmSettings;
+use App\Infrastructure\TaskVms\TaskVmWorkspaceTemplates;
+use App\Infrastructure\TaskVms\UpCloudServers;
+use App\Infrastructure\TaskVms\UpCloudTaskVmImageBuilder;
+use Illuminate\Contracts\Queue\ShouldBeUnique;
+use Illuminate\Contracts\Queue\ShouldQueue;
+use Illuminate\Foundation\Queue\Queueable;
+use Illuminate\Support\Facades\Log;
+
+/**
+ * The nightly UpCloud refresh: builds a new task VM template inside UpCloud with the shared recipe, as
+ * `task-vms:build-upcloud-image` does, and keeps the two newest verified templates. The first build is always that
+ * command, so while UpCloud has no verified template the job changes nothing. A failed build keeps the current
+ * template. It runs on the template queue, whose own worker runs one job at a time, so the build holds up no task VM
+ * job.
+ */
+final class RefreshUpCloudTaskVmTemplate implements ShouldBeUnique, ShouldQueue
+{
+    use Queueable;
+
+    public int $tries = 1;
+
+    /** The template worker's limit, below the queue's `retry_after` of 1800 seconds. A build takes about 20 minutes. */
+    public int $timeout = 1700;
+
+    public bool $failOnTimeout = true;
+
+    public int $uniqueFor = 3600;
+
+    public function __construct()
+    {
+        $this->onConnection('task-vms')->onQueue(TaskVmWorkspaceTemplates::Queue);
+    }
+
+    public function handle(TaskVmSettings $settings, UpCloudServers $servers, UpCloudTaskVmImageBuilder $builder): void
+    {
+        if ($settings->upcloud === null || $servers->currentTemplate() === null) {
+            return;
+        }
+
+        $template = $builder->build(static function (string $stage, float $seconds): void {
+            Log::info('UpCloud task VM template build stage done.', ['stage' => $stage, 'seconds' => $seconds]);
+        });
+        Log::info('UpCloud task VM template refreshed.', ['template' => $template]);
+    }
+}
diff --git a/apps/gateway/app/Jobs/TaskVms/SweepTaskVmHosts.php b/apps/gateway/app/Jobs/TaskVms/SweepTaskVmHosts.php
index 267e60ec9f..dfccdaba57 100644
