+{% extends "base.html" %}
+{% block title %}Akun Cloud — RDP Installer{% endblock %}
+
+{% block topnav %}
+<div class="topnav">
+  <a class="btn ghost small" href="/">dashboard</a>
+  <span class="who">{{ user.display_name() }}</span>
+</div>
+{% endblock %}
+
+{% block content %}
+<section class="card">
+  <div class="cardhead">
+    <h2>Akun cloud</h2>
+    <span class="muted small">maks {{ max_accounts }}</span>
+  </div>
+  <p class="muted small">Tempel API token UpCloud milik Anda sendiri. Kami uji dulu ke
+  <span class="mono">GET /1.3/account</span>, lalu menyimpannya terenkripsi (AES-256-GCM).
+  Token tidak pernah ditampilkan lagi — hanya 4 karakter awal dan akhir.</p>
+
+  {% if !notice.is_empty() %}<p class="ok-alert">{{ notice }}</p>{% endif %}
+  {% if !error.is_empty() %}<p class="alert">{{ error }}</p>{% endif %}
+
+  {% if accounts.is_empty() %}
+  <p class="empty">Belum ada akun cloud. Tambahkan satu untuk mulai membuat server Windows.</p>
+  {% else %}
+  <div class="tablewrap">
+  <table>
+    <thead><tr><th>#</th><th>Provider</th><th>Label</th><th>Status</th><th>Kredit</th><th>Diuji</th><th></th></tr></thead>
+    <tbody>
+    {% for a in accounts %}
+      <tr>
+        <td class="mono">{{ a.id }}</td>
+        <td class="mono">{{ a.provider }}</td>
+        <td>{{ a.label }}</td>
+        <td><span class="badge {{ a.status_class() }}">{{ a.status }}</span>
+          {% if !a.last_error.is_empty() %}<div class="dim small">{{ a.last_error }}</div>{% endif %}</td>
+        <td class="dim">{{ a.credit }}</td>
+        <td class="dim">{{ dt(a.last_checked) }}</td>
+        <td>
+          <div class="row">
+            <form method="post" action="/cloud/{{ a.id }}/check"><button class="btn ghost small" type="submit">uji</button></form>
+            <form method="post" action="/cloud/{{ a.id }}/delete"><button class="btn ghost small" type="submit">hapus</button></form>
+          </div>
+        </td>
+      </tr>
+    {% endfor %}
+    </tbody>
+  </table>
+  </div>
+  {% endif %}
+</section>
+
+<section class="card">
+  <h2>Tambah akun</h2>
+  <form method="post" action="/cloud" class="form">
+    <label>
+      <span class="label">Label</span>
+      <input type="text" name="label" placeholder="UpCloud utama" maxlength="60" autocomplete="off">
+    </label>
+    <label>
+      <span class="label">API token</span>
+      <input type="password" name="token" placeholder="ucat_..." autocomplete="off" spellcheck="false" required>
+    </label>
+    <p class="muted small">Buat di UpCloud Control Panel → Account → API Tokens. Beri masa berlaku
+    sesingkat yang nyaman dan batasi IP bila bisa.</p>
+    <div class="row"><button class="btn" type="submit">uji &amp; simpan</button></div>
+  </form>
+</section>
+{% endblock %}
