+              const isBuilding = server.vpsStatus === 'PROVISIONING' || server.serverState === 'maintenance';
+              const isError = server.vpsStatus === 'ERROR';
+              const isSelected = selectedServerIds.includes(server.id);
+
+              return (
+                <div
+                  key={server.id}
