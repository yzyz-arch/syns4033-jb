+import axios, { AxiosInstance } from 'axios';
+import { store } from '../db/store';
+
+export interface CreateServerParams {
+  title: string;
+  hostname: string;
+  zone: string;
+  plan: string;
+  storageUuid: string;
+  storageSizeGb: number;
