+      title="Toggle Sidebar (Ctrl+B)"
+      {...props}
+    >
+      <PanelLeft className="h-4.5 w-4.5" />
+    </button>
+  );
+};
+
+export const SidebarRail: React.FC<React.ButtonHTMLAttributes<HTMLButtonElement>> = ({
+  className = '',
+  ...props
+}) => {
