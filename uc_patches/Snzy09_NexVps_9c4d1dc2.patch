+  return (
+    <button
+      type="button"
+      onClick={() => toggleKey(id)}
+      className={`w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs font-semibold text-slate-400 hover:text-white hover:bg-slate-900/60 transition-colors cursor-pointer ${className}`}
+      {...props}
+    >
+      <div className="flex items-center gap-2.5 truncate">{children}</div>
+      <ChevronDown className={`w-3.5 h-3.5 text-slate-500 transition-transform duration-200 ${isOpen ? 'rotate-180 text-white' : ''}`} />
+    </button>
+  );
+};
+
+export const SidebarDisclosurePanel: React.FC<React.HTMLAttributes<HTMLDivElement>> = ({
+  className = '',
+  children,
+  ...props
+}) => {
+  const { isOpen } = useContext(SingleDisclosureContext);
+  const { state } = useSidebar();
+
+  if (!isOpen || state === 'collapsed') return null;
+
+  return (
+    <div className={`pl-4 space-y-1 border-l border-slate-800/80 ml-4 animate-in fade-in duration-150 ${className}`} {...props}>
+      {children}
+    </div>
+  );
+};
+
+/* ========================================================
+   8. TRIGGERS, RAILS & INSET
+   ======================================================== */
+
+export const SidebarTrigger: React.FC<React.ButtonHTMLAttributes<HTMLButtonElement>> = ({
+  className = '',
+  ...props
