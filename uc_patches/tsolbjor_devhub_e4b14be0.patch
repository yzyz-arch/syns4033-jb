index ec869e6..90afd24 100755
--- a/k8s/scripts/setup-env.sh
+++ b/k8s/scripts/setup-env.sh
@@ -34,6 +34,8 @@ REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
